# ============================================================
#  PhotoPrism — ตัวอย่างตัวแปรสำหรับ REST Client (VS Code)
# ============================================================
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#  ใช้ร่วมกับ api.http (ค่าเริ่มต้น admin/admin123 ตรงกับ seed)
# ============================================================

# ที่อยู่เซิร์ฟเวอร์
PHOTOPRISM_URL=http://localhost:3000

# บัญชีที่ใช้เข้าสู่ระบบ (ควรเป็น admin ถ้าจะยิง /admin/*)
PHOTOPRISM_USERNAME=admin
PHOTOPRISM_PASSWORD=admin123

# ข้อมูลสำหรับทดสอบสมัครสมาชิก (POST /api/v1/register)
PHOTOPRISM_SIGNUP_USERNAME=testuser
PHOTOPRISM_SIGNUP_EMAIL=test@example.com
PHOTOPRISM_SIGNUP_PASSWORD=123456

# รหัสผ่านใหม่สำหรับทดสอบเปลี่ยนรหัส (PATCH /api/v1/account/password)
PHOTOPRISM_NEW_PASSWORD=654321
