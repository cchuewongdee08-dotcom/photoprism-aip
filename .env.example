# ============================================================
#  PhotoPrism — ตัวอย่างตัวแปรสำหรับ REST Client (VS Code)
# ============================================================
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#  ใช้ร่วมกับ api.http (ค่าเริ่มต้นตรงกับข้อมูล seed ของโปรเจกต์)
# ============================================================

# ที่อยู่เซิร์ฟเวอร์
PHOTOPRISM_URL=http://localhost:3000

# บัญชีปกติ (ใช้ในข้อ 1-8 ของ api.http)
PHOTOPRISM_USERNAME=user1
PHOTOPRISM_PASSWORD=user123

# บัญชีผู้ดูแลระบบ (ใช้ในข้อ 9 ของ api.http)
PHOTOPRISM_ADMIN_USERNAME=admin
PHOTOPRISM_ADMIN_PASSWORD=admin123
