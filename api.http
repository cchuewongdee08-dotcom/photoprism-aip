# ============================================================
#  PhotoPrism AIP — REST API v1 (ยิงทดสอบใน VS Code)
# ============================================================
#
#  วิธีใช้
#  1) เปิดเซิร์ฟเวอร์ก่อน :  npm start
#  2) ติดตั้ง Extension :     REST Client (humao.rest-client)
#  3) ค่า URL / บัญชี อ่านจากไฟล์ .env อัตโนมัติ
#  4) กด "Send Request" เหนือคำขอที่ต้องการ
#
#  เรื่อง Session (สำคัญ)
#  ระบบใช้ express-session + cookie ชื่อ "photoprism.sid"
#  REST Client เปิด `rest-client.rememberCookiesForSubsequentRequests`
#  ไว้ (default = true) ดังนั้น "กด Login ครั้งเดียว"
#  แล้วคำขอถัดไปในไฟล์นี้จะส่ง cookie เดิมไปให้โดยอัตโนมัติ
#  จึงไม่จำเป็นต้องคัดลอก token เอง
# ============================================================


# ------------------------------------------------------------
#  ตัวแปร (อ่านค่าจาก .env)
# ------------------------------------------------------------
@baseUrl  = {{$dotenv PHOTOPRISM_URL}}
@username = {{$dotenv PHOTOPRISM_USERNAME}}
@password = {{$dotenv PHOTOPRISM_PASSWORD}}
@adminUsername = {{$dotenv PHOTOPRISM_ADMIN_USERNAME}}
@adminPassword = {{$dotenv PHOTOPRISM_ADMIN_PASSWORD}}


# ============================================================
#  1. เข้าสู่ระบบ
# ============================================================
#  ถูกต้อง -> 200 (และเซ็ต cookie ให้ใช้กับคำขอถัดไป)
#  รหัสผิด -> 401
# ============================================================

### 1. เข้าสู่ระบบ
POST {{baseUrl}}/api/v1/session
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

# ============================================================
#  2. ดูรูปที่ฉันอัปโหลด
# ============================================================
#  ใช้ session เดียวกับที่ Login (ต้องรันข้อ 1 ก่อน)
#  ยังไม่ Login -> 401
#  Login แล้ว   -> 200 (เห็นเฉพาะรูปของตัวเอง)
# ============================================================

### 2. ดูรูปที่ฉันอัปโหลด
GET {{baseUrl}}/api/v1/my-uploads
Accept: application/json


# ============================================================
#  3. ดูรูปภาพทั้งหมด
# ============================================================
#  page  = หน้าที่ต้องการ
#  limit = จำนวนรูปต่อหน้า (สูงสุด 30)
# ============================================================

### 3. ดูรูปภาพทั้งหมด
GET {{baseUrl}}/api/v1/photos?page=1&limit=9
Accept: application/json


# ============================================================
#  4. ค้นหารูปภาพ
# ============================================================
#  q = คำค้นหา (ค้นจากชื่อรูป คำอธิบาย แท็ก กล้อง ชื่อผู้ใช้)
# ============================================================

### 4. ค้นหารูปภาพ
GET {{baseUrl}}/api/v1/photos?q=แมว&page=1&limit=9
Accept: application/json


# ============================================================
#  5. สมัครสมาชิก
# ============================================================

### 5. สมัครสมาชิก (ได้สิทธิ์ user)
POST {{baseUrl}}/api/v1/register
Content-Type: application/json

{
  "username": "newmember",
  "email": "newmember@example.com",
  "password": "123456",
  "confirmPassword": "123456",
  "fullName": "สมาชิกใหม่"
}


# ============================================================
#  6. ตรวจสอบ / ออกจากระบบ
# ============================================================

### 6.1 ดูผู้ใช้ปัจจุบัน (ใช้ session เดิม)
GET {{baseUrl}}/api/v1/session
Accept: application/json

### 6.2 ออกจากระบบ
DELETE {{baseUrl}}/api/v1/session


# ============================================================
#  7. เปลี่ยนรหัสผ่านของตัวเอง
# ============================================================

### 7. เปลี่ยนรหัสผ่าน
PATCH {{baseUrl}}/api/v1/account/password
Content-Type: application/json

{
  "currentPassword": "{{password}}",
  "newPassword": "654321",
  "confirmPassword": "654321"
}


# ============================================================
#  8. รายละเอียดรูป / อัลบั้ม
# ============================================================

### 8.1 ดูรายละเอียดรูปภาพ (แก้เลข 1 เป็น id ที่ต้องการ)
GET {{baseUrl}}/api/v1/photos/1
Accept: application/json

### 8.2 ดึงรายการอัลบั้ม (ต้อง Login)
GET {{baseUrl}}/api/v1/albums


# ============================================================
#  9. ฝั่งผู้ดูแลระบบ (Admin)
# ============================================================
#  ต้องรันข้อ 1 ด้วยบัญชี admin ก่อน (แก้ค่าใน .env)
# ============================================================

### 9.1 สถิติระบบ
GET {{baseUrl}}/api/v1/admin/stats

### 9.2 รายชื่อผู้ใช้ทั้งหมด
GET {{baseUrl}}/api/v1/admin/users?page=1
