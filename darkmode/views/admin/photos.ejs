<%- include('../partials/header', { title }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h4 class="mb-1"><i class="bi bi-photo-album me-2"></i>จัดการรูปทั้งระบบ</h4>
    <p class="text-muted small mb-0">
      ผู้ดูแลระบบเห็นรูปทุกใบ รวมถึงรูปส่วนตัว (private) ของผู้ใช้ — ทั้งหมด <strong><%= total %></strong> รูป
      <% if (keyword) { %> · ค้นหา "<strong><%= keyword %></strong>"<% } %>
    </p>
  </div>
  <form class="d-flex gap-2" method="get" action="/admin/photos">
    <input type="text" name="q" class="form-control" placeholder="ค้นหารูปทั้งระบบ" value="<%= keyword %>">
    <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
  </form>
</div>

<% if (photos.length === 0) { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="bi bi-image display-4 text-muted"></i>
      <h5 class="mt-3">ไม่พบรูปภาพ</h5>
    </div>
  </div>
<% } else { %>
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 80px">ภาพ</th>
            <th>ชื่อรูป</th>
            <th>เจ้าของ</th>
            <th>Album</th>
            <th>สิทธิ์</th>
            <th>อัปโหลด</th>
            <th class="text-center" style="width: 130px">จัดการ</th>
          </tr>
        </thead>
        <tbody>
          <% photos.forEach((photo) => { %>
            <tr>
              <td>
                <a href="/photo/<%= photo.id %>">
                  <img src="/uploads/<%= photo.file_name %>" class="rounded table-thumb" alt="<%= photo.title %>">
                </a>
              </td>
              <td>
                <a href="/photo/<%= photo.id %>" class="fw-semibold text-decoration-none"><%= photo.title %></a>
                <div class="small text-muted"><code>#<%= photo.id %></code> · <%= (photo.file_size / 1024).toFixed(0) %> KB</div>
              </td>
              <td class="small">
                <%= photo.owner_name %><br>
                <code class="text-muted"><%= photo.owner_username %></code>
              </td>
              <td class="small">
                <% if (photo.album_name) { %>
                  <a class="badge bg-secondary text-decoration-none" href="/albums/<%= photo.album_id %>"><%= photo.album_name %></a>
                <% } else { %><span class="text-muted">-</span><% } %>
              </td>
              <td>
                <% if (photo.visibility === 'private') { %>
                  <span class="badge bg-dark"><i class="bi bi-lock-fill"></i> ส่วนตัว</span>
                <% } else { %>
                  <span class="badge bg-success"><i class="bi bi-unlock-fill"></i> สาธารณะ</span>
                <% } %>
              </td>
              <td class="small text-muted"><%= photo.created_at %></td>
              <td class="text-center">
                <div class="btn-group btn-group-sm">
                  <a class="btn btn-outline-secondary" href="/photos/<%= photo.id %>/edit" title="แก้ไข">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <form method="post" action="/admin/photos/<%= photo.id %>/delete" class="d-inline"
                        onsubmit="return confirmDelete('ยืนยันการลบรูป \"<%= photo.title %>\" ของ <%= photo.owner_username %> ?')">
                    <button class="btn btn-outline-danger" type="submit" title="ลบ">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/pagination', { baseUrl: '/admin/photos' }) %>
<% } %>

<%- include('../partials/footer') %>