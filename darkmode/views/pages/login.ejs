<%- include('../partials/header', { title }) %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card auth-card border-0">
      <div class="card-body p-4">
        <div class="text-center mb-4">
          <i class="bi bi-camera-fill auth-icon"></i>
          <h3 class="mt-2 mb-1">เข้าสู่ระบบ <%= appName %></h3>
          <p class="text-muted small mb-0">กรุณาเข้าสู่ระบบเพื่ออัปโหลดและจัดการรูปภาพ</p>
        </div>

        <% if (errors.form) { %>
          <div class="alert alert-danger py-2">
            <i class="bi bi-exclamation-octagon me-1"></i><%= errors.form %>
          </div>
        <% } %>

        <form method="post" action="/login" novalidate>
          <input type="hidden" name="next" value="<%= next %>">

          <div class="mb-3">
            <label class="form-label" for="username">ชื่อผู้ใช้</label>
            <input type="text" class="form-control <%= errors.username ? 'is-invalid' : '' %>"
                   id="username" name="username" value="<%= values.username || '' %>" autocomplete="username" autofocus>
            <% if (errors.username) { %><div class="invalid-feedback"><%= errors.username %></div><% } %>
          </div>

          <div class="mb-3">
            <label class="form-label" for="password">รหัสผ่าน</label>
            <input type="password" class="form-control <%= errors.password ? 'is-invalid' : '' %>"
                   id="password" name="password" autocomplete="current-password">
            <% if (errors.password) { %><div class="invalid-feedback"><%= errors.password %></div><% } %>
          </div>

          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-box-arrow-in-right me-1"></i>เข้าสู่ระบบ
          </button>
        </form>

        <hr class="my-4">
        <p class="text-center mb-0">
          ยังไม่มีบัญชี? <a href="/register">สมัครบัญชีใหม่</a>
        </p>
      </div>
    </div>

    <div class="card mt-3 border-0 bg-light">
      <div class="card-body small">
        <strong class="d-block mb-2">บัญชีสำหรับทดลองใช้งาน</strong>
        <table class="table table-sm mb-0 small">
          <thead><tr><th>สิทธิ์</th><th>ชื่อผู้ใช้</th><th>รหัสผ่าน</th></tr></thead>
          <tbody>
            <tr>
              <td><span class="badge bg-warning text-dark">Admin</span></td>
              <td><code>admin</code></td>
              <td><code>admin123</code></td>
            </tr>
            <tr>
              <td><span class="badge bg-info text-dark">User</span></td>
              <td><code>user1</code></td>
              <td><code>user123</code></td>
            </tr>
            <tr>
              <td><span class="badge bg-secondary">ถูกระงับ</span></td>
              <td><code>user3</code></td>
              <td><code>user123</code></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>