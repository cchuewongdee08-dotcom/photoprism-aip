<%- include('../partials/header', { title }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h4 class="mb-1"><i class="bi bi-person-images me-2"></i>รูปภาพของฉัน</h4>
    <p class="text-muted small mb-0">
      ผู้ใช้ <strong><%= currentUser.username %></strong> มีรูปทั้งหมด <strong><%= total %></strong> รูป
      <% if (keyword) { %> · ค้นหา "<strong><%= keyword %></strong>"<% } %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <form class="d-flex gap-2" method="get" action="/my/photos">
      <input type="text" name="q" class="form-control" placeholder="ค้นหาในรูปของฉัน" value="<%= keyword %>">
      <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
    </form>
    <a class="btn btn-primary" href="/upload"><i class="bi bi-cloud-arrow-up me-1"></i>อัปโหลด</a>
  </div>
</div>

<% if (photos.length === 0) { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="bi bi-cloud-upload display-4 text-muted"></i>
      <h5 class="mt-3">ยังไม่มีรูปภาพของคุณ</h5>
      <p class="text-muted">เริ่มต้นด้วยการอัปโหลดรูปแรกของคุณ</p>
      <a class="btn btn-primary" href="/upload"><i class="bi bi-cloud-arrow-up me-1"></i>อัปโหลดรูป</a>
    </div>
  </div>
<% } else { %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 90px">ภาพ</th>
            <th>ชื่อรูป</th>
            <th>Album</th>
            <th>สิทธิ์</th>
            <th>ขนาดไฟล์</th>
            <th>วันที่อัปโหลด</th>
            <th class="text-center" style="width: 160px">จัดการ</th>
          </tr>
        </thead>
        <tbody>
          <% photos.forEach((photo) => { %>
            <tr>
              <td>
                <a href="/photo/<%= photo.id %>">
                  <img src="/uploads/<%= photo.file_name %>" class="rounded table-thumb" alt="<%= photo.title %>">
                </a>
              </td>
              <td>
                <a href="/photo/<%= photo.id %>" class="fw-semibold text-decoration-none"><%= photo.title %></a>
                <div class="text-muted small text-truncate" style="max-width: 280px"><%= photo.description %></div>
              </td>
              <td>
                <% if (photo.album_name) { %>
                  <a class="badge bg-secondary text-decoration-none" href="/albums/<%= photo.album_id %>"><%= photo.album_name %></a>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <% if (photo.visibility === 'private') { %>
                  <span class="badge bg-dark"><i class="bi bi-lock-fill"></i> ส่วนตัว</span>
                <% } else { %>
                  <span class="badge bg-success"><i class="bi bi-unlock-fill"></i> สาธารณะ</span>
                <% } %>
              </td>
              <td class="small"><%= (photo.file_size / 1024).toFixed(1) %> KB</td>
              <td class="small"><%= photo.created_at %></td>
              <td class="text-center">
                <div class="btn-group btn-group-sm">
                  <a class="btn btn-outline-primary" href="/photos/<%= photo.id %>/edit" title="แก้ไข">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <a class="btn btn-outline-secondary" href="/photo/<%= photo.id %>" title="ดูรายละเอียด">
                    <i class="bi bi-eye"></i>
                  </a>
                  <form method="post" action="/photos/<%= photo.id %>/delete" class="d-inline"
                        onsubmit="return confirmDelete('ยืนยันการลบรูป \"<%= photo.title %>\" ?')">
                    <input type="hidden" name="redirect" value="/my/photos">
                    <button class="btn btn-outline-danger" type="submit" title="ลบ">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/pagination', { baseUrl: '/my/photos' }) %>
<% } %>

<%- include('../partials/footer') %>