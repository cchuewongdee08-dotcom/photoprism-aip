<%- include('../partials/header', { title }) %>

<div class="row justify-content-center">
  <div class="col-md-7 col-lg-6">
    <div class="card border-0 shadow-sm text-center">
      <div class="card-body p-5">
        <div class="display-3 fw-bold text-<%= statusCode === 403 ? 'danger' : statusCode === 404 ? 'warning' : 'secondary' %>">
          <%= statusCode %>
        </div>
        <h4 class="mt-3 mb-2"><%= title %></h4>
        <p class="text-muted"><%= message %></p>

        <% if (detail) { %>
          <div class="alert alert-light border text-start small">
            <pre class="mb-0 text-break"><%= detail %></pre>
          </div>
        <% } %>

        <% if (statusCode === 403) { %>
          <div class="alert alert-danger small text-start">
            <i class="bi bi-shield-lock me-1"></i>
            <strong>การตรวจสอบสิทธิ์ทำที่ฝั่ง Server</strong><br>
            คำขอนี้ถูกปฏิเสธโดย middleware <code>requireAdminPage</code> /
            <code>canManagePhoto</code> ก่อนที่จะไปถึงหน้าเว็บหรือข้อมูลใด ๆ
            แม้ผู้ใช้จะพิมพ์ URL หรือแก้ค่าในฟอร์มก็ตาม
          </div>
        <% } %>

        <div class="d-flex gap-2 justify-content-center mt-4">
          <a class="btn btn-primary" href="/"><i class="bi bi-house me-1"></i>กลับหน้าแกลเลอรี</a>
          <% if (statusCode === 401 || statusCode === 403) { %>
            <a class="btn btn-outline-secondary" href="/login">เข้าสู่ระบบ</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>