<%- include('../partials/header', { title }) %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card auth-card border-0">
      <div class="card-body p-4">
        <div class="text-center mb-4">
          <i class="bi bi-key-fill auth-icon"></i>
          <h3 class="mt-2 mb-1">รีเซ็ตรหัสผ่าน</h3>
          <p class="text-muted small mb-0">ใช้คีย์รีเซ็ตจากไฟล์ .env เพื่อตั้งรหัสผ่านใหม่โดยไม่ต้องทราบรหัสเดิม</p>
        </div>

        <% if (errors.form) { %>
          <div class="alert alert-danger py-2">
            <i class="bi bi-exclamation-octagon me-1"></i><%= errors.form %>
          </div>
        <% } %>

        <form method="post" action="/reset-password" novalidate>
          <div class="mb-3">
            <label class="form-label" for="token">คีย์รีเซ็ต *</label>
            <input type="password" class="form-control <%= errors.token ? 'is-invalid' : '' %>"
                   id="token" name="token" autocomplete="off" autofocus
                   placeholder="ค่า PASSWORD_RESET_TOKEN จาก .env">
            <% if (errors.token) { %><div class="invalid-feedback"><%= errors.token %></div><% } %>
          </div>

          <div class="mb-3">
            <label class="form-label" for="username">ชื่อผู้ใช้ *</label>
            <input type="text" class="form-control <%= errors.username ? 'is-invalid' : '' %>"
                   id="username" name="username" value="<%= values.username || '' %>" autocomplete="username">
            <% if (errors.username) { %><div class="invalid-feedback"><%= errors.username %></div><% } %>
          </div>

          <div class="mb-3">
            <label class="form-label" for="newPassword">รหัสผ่านใหม่ *</label>
            <input type="password" class="form-control <%= errors.newPassword ? 'is-invalid' : '' %>"
                   id="newPassword" name="newPassword" autocomplete="new-password">
            <% if (errors.newPassword) { %>
              <div class="invalid-feedback"><%= errors.newPassword %></div>
            <% } else { %>
              <div class="form-text">อย่างน้อย 6 ตัวอักษร</div>
            <% } %>
          </div>

          <div class="mb-3">
            <label class="form-label" for="confirmPassword">ยืนยันรหัสผ่านใหม่ *</label>
            <input type="password" class="form-control <%= errors.confirmPassword ? 'is-invalid' : '' %>"
                   id="confirmPassword" name="confirmPassword" autocomplete="new-password">
            <% if (errors.confirmPassword) { %><div class="invalid-feedback"><%= errors.confirmPassword %></div><% } %>
          </div>

          <button type="submit" class="btn btn-warning w-100">
            <i class="bi bi-key me-1"></i>รีเซ็ตรหัสผ่าน
          </button>
        </form>

        <hr class="my-4">
        <p class="text-center mb-0">
          <a href="/login"><i class="bi bi-arrow-left me-1"></i>กลับไปหน้าเข้าสู่ระบบ</a>
        </p>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
