<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= appName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark app-navbar">
  <div class="container">
    <a class="navbar-brand app-brand" href="/">
      <span class="brand-mark"><i class="bi bi-camera-fill"></i></span>
      <span><%= appName %></span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">
            <i class="bi bi-images me-1"></i>แกลเลอรี
          </a>
        </li>
        <% if (currentUser) { %>
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/upload' ? 'active' : '' %>" href="/upload">
              <i class="bi bi-cloud-arrow-up me-1"></i>อัปโหลด
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/my/photos' ? 'active' : '' %>" href="/my/photos">
              <i class="bi bi-person-images me-1"></i>รูปของฉัน
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/albums' ? 'active' : '' %>" href="/albums">
              <i class="bi bi-folder2 me-1"></i>Album
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/api-demo' ? 'active' : '' %>" href="/api-demo">
              <i class="bi bi-shield-check me-1"></i>ทดสอบสิทธิ์
            </a>
          </li>
        <% } %>

        <% if (isAdmin) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= currentPath.startsWith('/admin') ? 'active' : '' %>"
               href="/admin" data-bs-toggle="dropdown">
              <i class="bi bi-speedometer2 me-1"></i>สำหรับผู้ดูแล
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/admin"><i class="bi bi-graph-up me-2"></i>แดชบอร์ด</a></li>
              <li><a class="dropdown-item" href="/admin/users"><i class="bi bi-people me-2"></i>จัดการผู้ใช้</a></li>
              <li><a class="dropdown-item" href="/admin/photos"><i class="bi bi-photo-album me-2"></i>จัดการรูปทั้งระบบ</a></li>
              <li><a class="dropdown-item" href="/admin/logs"><i class="bi bi-clock-history me-2"></i>บันทึกการกระทำ</a></li>
            </ul>
          </li>
        <% } %>
      </ul>

      <ul class="navbar-nav">
        <% if (currentUser) { %>
          <li class="nav-item d-flex align-items-center me-2">
            <span class="nav-user-chip">
              <span class="avatar"><i class="bi bi-person"></i></span>
              <%= currentUser.fullName %>
              <% if (currentUser.role === 'admin') { %>
                <span class="badge bg-warning text-dark">Admin</span>
              <% } else { %>
                <span class="badge bg-info text-dark">User</span>
              <% } %>
            </span>
          </li>
          <li class="nav-item">
            <form method="post" action="/logout" class="d-inline">
              <button type="submit" class="btn btn-sm btn-outline-light">
                <i class="bi bi-box-arrow-right me-1"></i>ออกจากระบบ
              </button>
            </form>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/login">เข้าสู่ระบบ</a></li>
          <li class="nav-item"><a class="nav-link" href="/register">สมัครบัญชี</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<main class="container py-4">
  <% if (flash) { %>
    <div class="alert alert-<%= flash.type === 'danger' ? 'danger' : flash.type %> alert-dismissible fade show shadow-sm" role="alert">
      <i class="bi <%= flash.type === 'danger' ? 'bi-exclamation-octagon' : 'bi-check-circle' %> me-2"></i>
      <%= flash.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>