<%# การ์ดรูปภาพ ใช้ร่วมกันในหน้าแกลเลอรี / รูปของฉัน / Album / Admin %>
<div class="col">
  <div class="card photo-card h-100 shadow-sm border-0">
    <a href="/photo/<%= photo.id %>" class="text-decoration-none text-reset">
      <div class="photo-thumb">
        <img src="/uploads/<%= photo.file_name %>" alt="<%= photo.title %>" loading="lazy">
        <% if (photo.visibility === 'private') { %>
          <span class="badge bg-dark position-absolute top-0 end-0 m-2">
            <i class="bi bi-lock-fill"></i> ส่วนตัว
          </span>
        <% } %>
      </div>
      <div class="card-body pb-2">
        <h6 class="card-title text-truncate mb-1"><%= photo.title %></h6>
        <p class="card-text text-muted small text-truncate mb-0">
          <i class="bi bi-person me-1"></i><%= photo.owner_name || photo.owner_username %>
        </p>
      </div>
    </a>
    <div class="card-footer bg-white border-0 pt-0 pb-2 d-flex justify-content-between align-items-center small text-muted">
      <span><%= photo.created_at %></span>
      <span><%= photo.width %>×<%= photo.height %></span>
    </div>
  </div>
</div>